# Pult — пульт IT-службы. Проверено на Debian 13: systemd-analyze security → 1.2 OK.
# Установка: бинарник в /opt/pult/bin/pult, секреты в /etc/pult/pult.env (root:pult 0640),
# данные в /var/lib/pult (pult:pult 0750). Подготовка домена — docs/ad-setup.md.
[Unit]
Description=Pult IT service desk
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=pult
Group=pult
EnvironmentFile=/etc/pult/pult.env
WorkingDirectory=/var/lib/pult
# Миграции встроены в бинарник и идут под advisory lock — безопасно при каждом старте.
ExecStartPre=/opt/pult/bin/pult migrate
ExecStart=/opt/pult/bin/pult serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Изоляция
NoNewPrivileges=yes
# Единственное право — открыть порт 443 без root (встроенный HTTPS, [tls] в pult.toml или PULT_TLS_*).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/var/lib/pult
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
