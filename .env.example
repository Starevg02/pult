# Скопируйте в .env.local (в .gitignore) и замените CHANGEME. Загрузка: set -a; . ./.env.local; set +a
# Любой параметр pult.toml можно задать переменной; полный список — docs/install.md и deploy/pult.example.toml.

# --- Обязательные
PULT_SECRET_KEY=CHANGEME                      # не короче 32 символов: openssl rand -base64 48
PULT_DATABASE_URL=postgres://pult:CHANGEME@localhost:5432/pult
# PULT_DATABASE_PASSWORD_FILE=/run/secrets/db  # пароль БД из файла вместо адреса

# --- Сервер
PULT_LISTEN=127.0.0.1:8080
PULT_LOG_FORMAT=text                          # text | json
# PULT_DATA_DIR=/var/lib/pult                 # вложения, сертификат портала, secret.key
# PULT_BACKUP_DIR=/var/lib/pult/backups
# PULT_INITIAL_SUPERADMIN=ivanov              # логин, который станет суперадминистратором при первом входе
# PULT_TRUSTED_PROXIES=10.0.0.5               # обратные прокси, которым верим в X-Forwarded-For
# PULT_METRICS_TOKEN=CHANGEME                 # /metrics для Prometheus не с этого сервера

# --- HTTPS (без них — HTTP; или PULT_AUTO_TLS=1 с PULT_DATA_DIR — сертификат в админке)
# PULT_TLS_CERT=/etc/pult/tls/pult.chain.crt
# PULT_TLS_KEY=/etc/pult/tls/pult.key
# PULT_TLS_EXTRA_CERT=/etc/pult/tls/public.chain.crt   # вторая пара для другого имени (SNI)
# PULT_TLS_EXTRA_KEY=/etc/pult/tls/public.key
# PULT_AUTO_TLS=1

# --- AD
PULT_AD_BIND_PASSWORD=CHANGEME

# --- Команды pult (не сервер)
# PULT_CONFIG=/etc/pult/pult.toml           # путь к конфигу для любой команды (= --config)
# PULT_CHECK_AD_PASSWORD=CHANGEME            # pult check ad --login: пароль проверяемой учётки
# PULT_PHONEBOOK_MSSQL="Server=tcp:sql.example.test,1433;Database=PhonebookDB;Encrypt=true"  # pult import phonebook, без пароля
# PULT_PHONEBOOK_USER=svc-pult-sql
# PULT_PHONEBOOK_PASSWORD=CHANGEME           # или --windows-auth
# PULT_PORTAL=https://pult.example.com       # pult-helper на ПК инженера: адрес портала

# --- Только для разработки и тестов (не на сервере)
# PULT_INSECURE_COOKIES=1     # cookie без Secure для http://localhost
# PULT_INSECURE_MAIL=1        # SMTP без TLS (Mailpit)
# PULT_TEST_DATABASE_URL=postgres://pult:CHANGEME@localhost:5432/pult_test
# Для compose.dev.yml (тестовые значения по умолчанию заданы в самом файле)
PULT_DEV_DB_PASSWORD=CHANGEME
PULT_DEV_SAMBA_ADMIN_PASSWORD=CHANGEME
